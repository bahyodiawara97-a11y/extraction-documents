# Copier ce fichier en .env et remplir les valeurs.
# .env est ignoré par git (voir .gitignore) : ne jamais committer de clé.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modèle utilisé pour la structuration.
# Vérifier les identifiants disponibles sur docs.claude.com avant de figer cette valeur.
ANTHROPIC_MODEL=claude-sonnet-5

# Langue passée à Tesseract pour l'OCR (fra, eng, fra+eng...)
OCR_LANG=fra
